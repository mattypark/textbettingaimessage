{
  "name": "textbettingaimessage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "typecheck": "tsc --noEmit",
    "agent:smoke": "node --env-file=.env.local node_modules/.bin/tsx scripts/agent-smoke.ts",
    "webhooks:dev": "linq webhooks listen --forward-to http://localhost:3000/api/webhooks/linq --events message.received,reaction.added,reaction.removed,participant.added,chat.created",
    "tick:dev": "node --env-file=.env.local node_modules/.bin/tsx scripts/tick-loop.ts",
    "linq:capture": "node --env-file=.env.local node_modules/.bin/tsx scripts/linq-capture.ts",
    "inbox:tail": "node --env-file=.env.local node_modules/.bin/tsx scripts/inbox-tail.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@linqapp/sdk": "^0.29.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "exifr": "^7.1.3",
    "ffmpeg-static": "^5.3.0",
    "framer-motion": "^13.4.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "16.3.5",
    "openai": "^7.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "fast-check": "^4.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}

# Copy to .env.local and fill in. Never commit .env.local.

# Which iMessage provider handles this deployment: linq | sendblue | fake
TRANSPORT=linq

# points = non-redeemable units + social forfeits (v1, legal in all 50 states)
# cash   = refuses to boot unless LEGAL_CLEARANCE=1 and CASH_PARTNER is set
STAKE_MODE=points
LEGAL_CLEARANCE=
CASH_PARTNER=
# Settle-up: after a SOCIAL stake settles, post Venmo / Cash App / PayPal links (Apple Cash = instruction) that open the
# loser's own app pointed at the winner. Mushy never holds or moves money. 0 = off.
SETTLE_UP=1

# Invite-only gate for the bot (1 = need an invite code / waitlist promotion; 0 = open, for dev)
INVITE_ONLY=1

# Comma-separated names the bot answers to in a group ("mushy", "@mushy")
BOT_NAMES=mushy
# Spam guard: how many bot turns one person / one chat can trigger per hour (reactions don't count)
BOT_TURNS_PER_USER_HOUR=30
BOT_TURNS_PER_CHAT_HOUR=120
# The bot line, shown on the landing page CTA (sms: link)
NEXT_PUBLIC_BOT_NUMBER=+12053968556
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Linq (docs.linqapp.com) — sandbox is free; `linq login` then `linq tokens`
LINQ_API_KEY=
LINQ_WEBHOOK_SECRET=
LINQ_FROM_NUMBER=

# Sendblue (docs.sendblue.com) — secondary adapter
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=
SENDBLUE_SIGNING_SECRET=

# Dev only: render /app from seeded fixtures with no Supabase. Ignored on Vercel or when Supabase is set.
WEB_DEMO=0

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# How much the model does. MODEL_MODE=off runs the scripted bet builder only (no tokens ever);
# assist (default) also lets it parse one-liners like "20 says i make this by friday, jake you in?".
MODEL_MODE=assist
# Who calls the result. confirm (default, free): the opponent replies "call #id yes/no".
# vision: the model judges the proof photo/video.
JUDGE_MODE=confirm

# LLM — one key is enough. OpenAI is used when OPENAI_API_KEY is set (MODEL_PROVIDER=anthropic|openai forces one).
# Big model = agent turns + vision judge; small = the follow-up classifier.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_MODEL_SMALL=gpt-5-mini
ANTHROPIC_API_KEY=

# Supabase Auth "Send SMS" hook secret (Auth → Hooks); the bot line delivers OTPs
SUPABASE_AUTH_HOOK_SECRET=

# Bearer for /api/cron/tick (pg_cron → pg_net calls it every minute)
CRON_SECRET=
